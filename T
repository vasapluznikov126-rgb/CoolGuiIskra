-- Функция крепления плаща к персонажу
local function attachCape(character, capeRoot)
    local Dummy = workspace:WaitForChild("TestDummy")
    if not Dummy then
        warn("TestDummy не найден!")
        return false
    end

    local Cape = Dummy:FindFirstChild("Cape")
    if not Cape then
        warn("Cape не найден в TestDummy!")
        return false
    end

    Cape = Cape:Clone()
    Cape.Parent = character

    local capePart = Cape:WaitForChild("Cape")
    local capPart = Cape:WaitForChild("cap")

    capePart.Anchored = false
    capePart.CanCollide = false
    if capPart then
        capPart.Anchored = false
    end

    -- Удаляем оригинальный дамми
    if Dummy and Dummy.Parent == workspace then
        Dummy:Destroy()
    end

    -- Поиск торса
    local torso = character:FindFirstChild("Torso") or character:FindFirstChild("UpperTorso")
    if not torso then
        warn("Торс не найден!")
        Cape:Destroy()
        return false
    end

    -- Сварки (подбери позицию под свою модель)
    local Weld1 = Instance.new("Weld")
    local Weld2 = Instance.new("ManualWeld")
    Weld1.Name = "Minkal"
    Weld2.Name = "Konserva"
    Weld1.Parent = capPart
    Weld2.Parent = capPart
    Weld1.Part0 = capePart
    Weld2.Part0 = capePart
    Weld1.Part1 = torso
    Weld2.Part1 = capPart

    local position = Vector3.new(-0.15, 1, -0.05)
    Weld1.C0 = CFrame.new(position) * CFrame.fromMatrix(
        Vector3.new(0,0,0),
        Vector3.new(0.16439898312091827, 0, -50),
        Vector3.new(0,1,0),
        Vector3.new(50, 0, 0.16439898312091827)
    )
    Weld2.C0 = CFrame.Angles(math.rad(-0.01), math.rad(29.9), 0)

    -- Скрываем все кости (они будут невидимыми, но мы будем их двигать)
    local function hideBones(part)
        if part and part:IsA("BasePart") then
            part.Visible = false
        end
    end

    local Bone = capePart:FindFirstChild("Bone")
    if not Bone then
        warn("Кость Bone не найдена!")
        return false
    end
    hideBones(Bone)

    -- Рекурсивный сбор всех костей
    local function collectBones(parentPart, parentBone)
        for _, child in ipairs(parentPart:GetChildren()) do
            if child:IsA("BasePart") then
                hideBones(child)
                bones[child] = {
                    part = child,
                    parent = parentBone,
                    localPos = parentBone and (child.Position - parentBone.Position) or Vector3.new(0,0,0),
                    pos = child.Position,
                    prevPos = child.Position,
                }
                collectBones(child, child)
            end
        end
    end
    collectBones(Bone, Bone)

    return true
end

-- Функция запуска физики
local function startPhysics(torso)
    if physicsConnection then
        physicsConnection:Disconnect()
        physicsConnection = nil
    end

    physicsConnection = runService.RenderStepped:Connect(function(dt)
        local character = player.Character
        if not character or not torso or not torso.Parent then
            -- если персонаж исчез, отключаем физику
            physicsConnection:Disconnect()
            physicsConnection = nil
            return
        end

        local velocity = torso.Velocity
        local speed = velocity.Magnitude

        -- Шаг 1: обновление позиций по Verlet
        for part, data in pairs(bones) do
            if not part.Parent then continue end

            local vel = (data.pos - data.prevPos) * (1 - DAMPING)
            local newPos = data.pos + vel + GRAVITY * dt * dt

            -- Ветер от движения
            if speed > 0.5 then
                local windDir = velocity.Unit
                local windStrength = math.min(speed / 20, 1.5) * WIND_FORCE
                newPos = newPos + windDir * windStrength * dt
            end

            data.prevPos = data.pos
            data.pos = newPos
        end

        -- Шаг 2: коррекция расстояний между костями
        for _ = 1, ITERATIONS do
            for part, data in pairs(bones) do
                if data.parent then
                    local parentPos = data.parent.Position
                    local dir = (data.pos - parentPos).Unit
                    local desiredLength = (data.localPos).Magnitude
                    local currentLength = (data.pos - parentPos).Magnitude

                    if currentLength > 0.01 then
                        local correction = (desiredLength - currentLength) * 0.5
                        data.pos = data.pos + dir * correction
                        -- родитель не двигаем (он приварен к торсу)
                    end
                end
            end
        end

        -- Шаг 3: применение новых позиций
        for part, data in pairs(bones) do
            local rot = part.CFrame.Rotation
            part.CFrame = CFrame.new(data.pos) * rot
        end
    end)
end

