local function initializeCharacter(newChar)
    if not scriptRunning then return end

    character = newChar
    disableAnimate()

    local function waitForHumanoid(char, timeout)
        local start = tick()
        while tick() - start < timeout do
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then return hum end
            task.wait(0.1)
        end
        return nil
    end
    Humanoid = waitForHumanoid(character, 2)
    if not Humanoid then
        warn("Humanoid не найден за 2 секунды при инициализации персонажа, пропускаем.")
        return
    end

    dataFolder = character:WaitForChild("Data")

    stopAnimationSystem = false
    animationLocked = false

    -- 👇 новые строки для сброса кулдауна переключения режимов
    if modeSwitchTimer then
        task.cancel(modeSwitchTimer)
        modeSwitchTimer = nil
    end
    modeSwitchCooldown = false
    -- 👆

    pendingFinalSwing = false
    if pendingFinalTimer then
        task.cancel(pendingFinalTimer)
        pendingFinalTimer = nil
    end

    actionAnimTrack = Humanoid:LoadAnimation(actionAnimation)
    actionAnimTrack.Priority = Enum.AnimationPriority.Core
    actionAnimTrack:SetAttribute("LockHooked", nil)

