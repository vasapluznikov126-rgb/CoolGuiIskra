local function executeCommand(cmd)
	table.insert(commandHistory, cmd)
	historyIndex = #commandHistory + 1
	
	addConsoleLine(cmd, Color3.fromRGB(100, 200, 255))
	
	local args = {}
	for arg in cmd:gmatch("%S+") do
		table.insert(args, arg)
	end
	
	if #args == 0 then return end
	
	local commandName = args[1]:lower()
	table.remove(args, 1)
	
	if commandName == "clear" or commandName == "cls" then
		for _, child in pairs(OutputContainer:GetChildren()) do
			if child:IsA("TextLabel") then
				child:Destroy()
			end
		end
		addConsoleLine("Консоль очищена", Color3.fromRGB(100, 255, 100))
		
	elseif commandName == "help" then
		addConsoleLine("Доступные команды:", Color3.fromRGB(255, 255, 100))
		addConsoleLine("  clear/cls - Clear console", Color3.fromRGB(200, 200, 200))
		addConsoleLine("  help - Shows commands", Color3.fromRGB(200, 200, 200))
		addConsoleLine("  echo [text] - Print anything", Color3.fromRGB(200, 200, 200))
		addConsoleLine("  fps - Shows FPS", Color3.fromRGB(200, 200, 200))
		addConsoleLine("  ping - Checks your ping", Color3.fromRGB(200, 200, 200))
		addConsoleLine("  exec [luacode] - Write your super cool code and execute it", Color3.fromRGB(200, 200, 200))
		addConsoleLine("  gui [show/hide] - Control gui(rn only hide and show)", Color3.fromRGB(200, 200, 200))
		
	elseif commandName == "echo" then
		local text = table.concat(args, " ")
		addConsoleLine(text, Color3.fromRGB(255, 200, 100))
		
	elseif commandName == "fps" then
		local fps = 1 / RunService.RenderStepped:Wait()
		addConsoleLine("FPS: " .. math.floor(fps), Color3.fromRGB(100, 255, 100))
		
	elseif commandName == "ping" then
		local startTime = tick()
		local endTime = tick()
		local ping = math.floor((endTime - startTime) * 1000)
		addConsoleLine("Ping: " .. ping .. "ms", Color3.fromRGB(100, 255, 100))
		
	elseif commandName == "exec" then
		local code = table.concat(args, " ")
		local success, result = pcall(function()
			return loadstring(code)()
		end)
		
		if success then
			addConsoleLine("Result: " .. tostring(result), Color3.fromRGB(100, 255, 100))
		else
			addConsoleLine("Error: " .. tostring(result), Color3.fromRGB(255, 100, 100))
		end
		
	elseif commandName == "gui" then
		if args[1] == "hide" then
			MainFrame.Visible = false
			addConsoleLine("GUI hide", Color3.fromRGB(100, 255, 100))
		elseif args[1] == "show" then
			MainFrame.Visible = true
			addConsoleLine("GUI show", Color3.fromRGB(100, 255, 100))
		else
			addConsoleLine("Use: gui [show/hide]", Color3.fromRGB(255, 100, 100))
		end
		
	else
		if commands[commandName] then
			local success, errorMsg = pcall(function()
				commands[commandName](args)
			end)
			
			if not success then
				addConsoleLine("Callback error: " .. errorMsg, Color3.fromRGB(255, 100, 100))
			end
		else
			addConsoleLine("Unknowm command: " .. commandName, Color3.fromRGB(255, 100, 100))
			addConsoleLine("Write 'help' for show commands", Color3.fromRGB(255, 200, 100))
		end
	end
	
	StatusBar.Text = "Command executed: " .. commandName
end

